# .env

COMMON_HOST=127.0.0.1
COMMON_PORT=8000
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ----------------------------
# AUTH 
# ----------------------------
AUTH_ENV=local
AUTH_HOST=${COMMON_HOST}
AUTH_PORT=${COMMON_PORT}
AUTH_BASE_URL=http://${AUTH_HOST}:${AUTH_PORT}

# Endpoints
LOGIN_API_ENDPOINT=${AUTH_BASE_URL}/login
REGISTER_API_ENDPOINT=${AUTH_BASE_URL}/register
LOGOUT_API_ENDPOINT=${AUTH_BASE_URL}/logout

# JWT / Security
SECRET_KEY=  # 32 byte minimum key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------
# MESSAGING 
# ----------------------------
MESSAGING_ENV=local
MESSAGING_HOST=${COMMON_HOST}   
MESSAGING_PORT=${COMMON_PORT}
MESSAGING_BASE_URL=http://${MESSAGING_HOST}:${MESSAGING_PORT}

# Conversations
CONVERSATIONS_BASE=/conversations
CONVERSATION_LIST_ENDPOINT=${MESSAGING_BASE_URL}${CONVERSATIONS_BASE}           # GET list
CONVERSATION_CREATE_ENDPOINT=${MESSAGING_BASE_URL}${CONVERSATIONS_BASE}         # POST create
CONVERSATION_UPDATE_ENDPOINT=${MESSAGING_BASE_URL}${CONVERSATIONS_BASE}/{id}    # PATCH rename title
CONVERSATION_DELETE_ENDPOINT=${MESSAGING_BASE_URL}${CONVERSATIONS_BASE}/{id}    # DELETE conversation

# Messages
MESSAGE_SEND_ENDPOINT=${MESSAGING_BASE_URL}/chat                            # POST new chat
MESSAGE_LIST_ENDPOINT=${MESSAGING_BASE_URL}${CONVERSATIONS_BASE}/{id}/messages  # GET message history

# ----------------------------
# MONITORING
# ----------------------------
MONITORING_ENV=local
MONITORING_HOST=${COMMON_HOST}
MONITORING_PORT=${COMMON_PORT}
MONITORING_BASE_URL=http://${MONITORING_HOST}:${MONITORING_PORT}
RATE_LIMIT_STATUS_ENDPOINT=${MONITORING_BASE_URL}/rate-limit/status

# ----------------------------
# DATABASE
# ----------------------------
# Single database containing users, conversations, and messages tables
# with proper foreign key constraints and cascade deletes
APP_DB_ENV=local
APP_DB_PROVIDER=SQLITE
APP_DB_PATH=data/app.db
# TODO future: consider a logs db where to check action-users-session-timestamp

# no sql db for user preferences
PREFERENCES_DB_ENV=local
PREFERENCES_DB_PROVIDER=TINYDB
PREFERENCES_DB_PATH=data/preferences.json

# vector database for movies
MOVIES_DB_ENV=local
MOVIES_DB_PROVIDER=CHROMA
MOVIES_DB_PATH=data/movies

# ----------------------------
# AGENT
# ----------------------------
AGENT_ENV=local
AGENT_FRAMEWORK=LANGCHAIN
AGENT_HOST=${COMMON_HOST}
AGENT_PORT=${COMMON_PORT}
AGENT_BASE_URL=http://${AGENT_HOST}:${AGENT_PORT}
AGENT_ENDPOINT=${AGENT_BASE_URL}/agent
AGENT_WEB_SEARCH=true
BRAVE_SEARCH_API_KEY=  # your API key

# ----------------------------
# LLM
# ----------------------------
LLM_PROVIDER=groq # OPENAI 
PROVIDER_BASE_URL=https://api.groq.com/openai/v1
PROVIDER_API_KEY=  # your API key
LLM_MODEL=llama-3.3-70b-versatile


# ----------------------------
# DATA DOWNLOAD
# ----------------------------
MOVIE_DATA_SOURCE=TMDB
MOVIE_DATA_SOURCE_BASE_URL=https://api.themoviedb.org/3
MOVIE_DATA_SOURCE_API_KEY=  # your API key
MOVIE_DATA_OUTPUT_PATH=data/movies.json
MOVIE_AMOUNT=1000
MOVIE_OUTPUT_FORMAT=JSON

# ----------------------------
# INGESTION
# ----------------------------
MOVIE_DATA_SOURCE_TYPE=JSON
MOVIE_DATA_INPUT_PATH=${MOVIE_DATA_OUTPUT_PATH}
OVERWRITE_MOVIES_DB=true